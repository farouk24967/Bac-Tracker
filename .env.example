# ─────────────────────────────────────────────────────────────────────────
#  Exemple de configuration. Copier vers .env et remplir les valeurs.
#  NE PAS committer de vraies clés, et ne jamais utiliser le préfixe VITE_
#  pour des secrets : VITE_* est embarqué dans le bundle client (public).
# ─────────────────────────────────────────────────────────────────────────

# Clés Base44 — utilisées uniquement côté serveur par la fonction /api/ai.
BASE44_APP_ID="YOUR_BASE44_APP_ID"
BASE44_API_KEY="YOUR_BASE44_API_KEY"

# Origines autorisées à appeler /api/ai (séparées par des virgules).
# Le motif "*.vercel.app" couvre le domaine de production et les aperçus.
# En production : ALLOWED_ORIGINS="http://localhost:3000,*.vercel.app"
ALLOWED_ORIGINS="http://localhost:3000,*.vercel.app"

# URL où l'application est hébergée.
APP_URL="YOUR_APP_URL"
